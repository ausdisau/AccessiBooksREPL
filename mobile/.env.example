# Public API origin for the existing AccessiBooks Express service.
EXPO_PUBLIC_API_BASE_URL=https://your-accessibooks-api.example

# Public PostHog project key. Keep personal API keys and CLI keys out of EXPO_PUBLIC_* variables.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
