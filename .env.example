# Required Environment Variables
DATABASE_URL=postgresql://user:password@localhost:5432/accessibooks
SESSION_SECRET=gYp3NE9r8I50XubixAfnGBjz2wvOcU7D
PORT=5000
# After pulling schema changes (e.g. user_preferences), run: npm run db:push

# Optional: S3/GCS for uploaded audiobooks (admin)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# GCS_BUCKET=
# GCS_KEY_FILE=
# ADMIN_EMAILS=admin@example.com

# Optional: Google Play / Google Books (catalog + read links)
# Get key: https://console.cloud.google.com/apis/credentials
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Optional: Amazon / Audible (Product Advertising API 5.0; requires Associates/affiliate account)
# PA-API is deprecated April 2026; migrate to Creators API when available.
# AMAZON_ACCESS_KEY=your-access-key
# AMAZON_SECRET_KEY=your-secret-key
# AMAZON_PARTNER_TAG=your-partner-tag
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1

# Optional: Uncomment to enable OAuth providers
# FACEBOOK_APP_ID=
# MICROSOFT_CLIENT_ID=
# AUTH0_DOMAIN=


# Optional: OCLC WorldCat Search API 2.0 for commercial-title ISBN discovery.
# Requires an eligible OCLC subscription/partner arrangement and WSKey credentials.
# Credentials are server-side only. Never expose the secret to the browser.
# OCLC_WORLDCAT_CLIENT_ID=
# OCLC_WORLDCAT_CLIENT_SECRET=
# OCLC_WORLDCAT_REGISTRY_ID=
# OCLC_WORLDCAT_API_BASE=https://americas.discovery.api.oclc.org
# OCLC_TOKEN_URL=https://oauth.oclc.org/token


# Optional: EBSCO Discovery Service (EDS) for institution-scoped discovery and full text.
# Requires an EBSCO customer profile enabled for EDS API access.
# New implementations may also be issued an x-api-key; it does not replace auth/session tokens.
# EBSCO_EDS_USER_ID=
# EBSCO_EDS_PASSWORD=
# EBSCO_EDS_PROFILE=
# EBSCO_EDS_INTERFACE_ID=wsapi
# EBSCO_EDS_ORG=AccessiBooks Hospitals
# EBSCO_EDS_API_KEY=
# EBSCO_EDS_BASE_URL=https://eds-api.ebscohost.com


# AccessiBooks @ Hospitals - commercial/research connectors

# VitalSource REST API. Server-side secret only.
# VITALSOURCE_API_KEY=
# VITALSOURCE_API_BASE=https://api.vitalsource.com

# Crossref REST API. Public works without registration; a contact email enables the polite pool.
# CROSSREF_MAILTO=
# CROSSREF_PLUS_TOKEN=
# CROSSREF_API_BASE=https://api.crossref.org

# Springer Nature Meta / Full Text APIs.
# SPRINGER_NATURE_API_KEY=
# SPRINGER_NATURE_API_METRIC=
# SPRINGER_NATURE_API_BASE=https://api.springernature.com

# Clarivate Web of Science Starter and Journals APIs.
# WOS_STARTER_API_KEY=
# WOS_STARTER_BASE_URL=https://api.clarivate.com/apis/wos-starter/v1
# WOS_JOURNALS_API_KEY=
# WOS_JOURNALS_BASE_URL=https://api.clarivate.com/apis/wos-journals/v1

# Elsevier / ScienceDirect. API key required; institutional token is optional and entitlement-specific.
# ELSEVIER_API_KEY=
# ELSEVIER_INST_TOKEN=
# ELSEVIER_API_BASE=https://api.elsevier.com

# News API. Development key is not licensed for production use.
# NEWS_API_KEY=
# NEWS_API_BASE=https://newsapi.org

# LexisNexis Nexis Data as a Service is partnership-provisioned.
# Do not invent endpoints here: add token/search/retrieve URLs only after the licensed
# LexisNexis developer portal exposes the contract for the selected DaaS product.

# OverDrive Discovery/Circulation APIs.
# OVERDRIVE_CLIENT_KEY=
# OVERDRIVE_CLIENT_SECRET=
# OVERDRIVE_LIBRARY_ID=
# OVERDRIVE_COLLECTION_TOKEN=
# OVERDRIVE_TOKEN_URL=https://oauth.overdrive.com/token
# OVERDRIVE_API_BASE=https://api.overdrive.com
